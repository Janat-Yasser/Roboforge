{
  "name": "roboforge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @roboforge/web dev",
    "build": "pnpm --filter @roboforge/web build",
    "start": "pnpm --filter @roboforge/web start",
    "worker": "pnpm --filter @roboforge/worker start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @roboforge/web typecheck",
    "db:generate": "pnpm --filter @roboforge/db generate",
    "db:migrate": "pnpm --filter @roboforge/db migrate",
    "db:seed": "pnpm --filter @roboforge/db seed",
    "sandbox:build": "node infra/sandbox/build.mjs",
    "e2e": "node e2e/v1-flow.mjs",
    "db:up": "docker compose up -d db",
    "db:local": "pnpm --filter @roboforge/local-db start",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.56.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
