DATABASE_URL=postgresql://roboforge:roboforge@localhost:5432/roboforge
# Object storage root for build artifacts (local filesystem store in V1)
ARTIFACT_DIR=./.data/artifacts
# Optional: enables the AI assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Sandbox image used by the build worker (see infra/sandbox)
SANDBOX_IMAGE=roboforge/sandbox-native:1
